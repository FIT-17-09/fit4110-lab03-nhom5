{
  "name": "fit4110_lab03_postman_mock_testing",
  "version": "0.3.0",
  "private": true,
  "description": "FIT4110 Lab 03 - Postman, Mock Server, Contract Testing, Newman CI",
  "scripts": {
    "mock:gate": "prism mock contracts/openApi.yaml -p 4010 --host 0.0.0.0",
    "mock:all": "sh -c 'npm run mock:iot & npm run mock:vision & wait'",
    "lint:contracts": "npx @redocly/cli lint contracts/*.yaml",
    "test:mock": "newman run postman/collections/access_gate.postman_collection.json -e postman/environments/FIT4110_lab03_mock.postman_environment.json --reporters cli,junit,htmlextra --reporter-junit-export reports/newman-report-mock.xml --reporter-htmlextra-export reports/newman-report.html",
    "test:local": "newman run postman/collections/access_gate.postman_collection.json -e postman/environments/FIT4110_lab03_local.postman_environment.json --reporters cli,junit,htmlextra --reporter-junit-export reports/newman-report-local.xml --reporter-htmlextra-export reports/newman-report-local.html",
    "test:ci": "npm run lint:contracts && npm run test:mock"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.16.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^7.2.0"
  }
}
